            <Box style={{ width: 328, background: '#ffffff', border: '1px solid #dccdb0', borderRadius: 10, padding: 28, flexDirection: 'column' }}>
                <Text style={{ fontFamily: "'PingFang SC'", fontSize: 16, color: '#a8895a', letterSpacing: 3 }}>学生端 · 手机自助</Text>
